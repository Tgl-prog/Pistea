{
  "appId": "app.vallik",
  "appName": "Vallik",
  "webDir": "www",
  "backgroundColor": "#0E2A47",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0E2A47",
    "overrideUserAgent": "Mozilla/5.0 (PisteaApp; iOS) AppleWebKit/605.1.15 (KHTML, like Gecko) PisteaNative/1.0"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "apple.com",
        "google.com"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        }
      }
    }
  }
}
